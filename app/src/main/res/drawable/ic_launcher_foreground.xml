<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher foreground: a stylised bowling-pin silhouette inside
    a mint trajectory ring, sitting on the deep-navy background defined in
    colors.xml. The 108dp canvas / 66dp safe area follows the Android
    adaptive-icon spec; everything that must be visible across launcher
    shapes is contained inside the inner safe rectangle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer trajectory ring; deliberately drawn as a stroked circle so the
         monochrome themed-icon variant renders cleanly on Android 13+. -->
    <path
        android:strokeColor="#00D9A3"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M54,28 a26,26 0 1 0 0.01,0 Z" />

    <!-- Bowling pin silhouette -->
    <path
        android:fillColor="#F5F7FA"
        android:pathData="
            M54,32
            c-3,0 -5.4,2.4 -5.4,5.4
            c0,1.6 0.7,3 1.8,4
            c-3.5,2.6 -5.6,7 -5.6,12.4
            c0,4.8 1.4,8.7 3.6,11.6
            c-1.4,1.4 -2.6,3.4 -2.6,5.6
            c0,4.4 3.6,8 8.2,8
            s8.2,-3.6 8.2,-8
            c0,-2.2 -1.2,-4.2 -2.6,-5.6
            c2.2,-2.9 3.6,-6.8 3.6,-11.6
            c0,-5.4 -2.1,-9.8 -5.6,-12.4
            c1.1,-1 1.8,-2.4 1.8,-4
            C59.4,34.4 57,32 54,32 Z" />

    <!-- Coral fall marker dot, hinting at the analysis output -->
    <path
        android:fillColor="#FF4757"
        android:pathData="M78,72 m-3,0 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0" />
</vector>
